{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/notifications-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/notifications-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/notifications-api",
  "projects": {
    "notifications-api": {
      "type": "application",
      "root": "apps/notifications-api",
      "entryFile": "main",
      "sourceRoot": "apps/notifications-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications-api/tsconfig.app.json"
      }
    },
    "worker-email": {
      "type": "application",
      "root": "apps/worker-email",
      "entryFile": "main",
      "sourceRoot": "apps/worker-email/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-email/tsconfig.app.json"
      }
    }
  }
}